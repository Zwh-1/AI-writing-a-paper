{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Section candidate v1",
  "type": "object",
  "required": [
    "paragraphs"
  ],
  "properties": {
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preserve_node_id": {
            "type": "string"
          }
        }
      }
    },
    "missing_materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}